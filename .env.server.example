# Reference only. ./scripts/start-server.sh creates .env.server with random secrets.
# Do not commit .env.server or copy its contents into chat, issues or logs.
POSTGRES_PASSWORD=
APP_SECRET=
SETUP_TOKEN=
APP_IMAGE=ghcr.io/xinglabs/guanxing:latest
PGVECTOR_IMAGE=pgvector/pgvector:pg17
CADDY_IMAGE=caddy:2-alpine
NODE_IMAGE=node:22-bookworm-slim
# Empty domain keeps the server private behind an SSH tunnel.
APP_DOMAIN=
APP_ORIGIN=http://127.0.0.1:3080,http://localhost:3080
MODEL_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,openrouter.ai
