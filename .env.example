# Copying this file is optional: scripts/start-local.sh creates a local .env.
# Set a unique URL-safe password (hex is recommended). Never commit .env.
POSTGRES_PASSWORD=
APP_PORT=3000

# Optional trusted image overrides. Defaults remain the official upstream images.
# NODE_IMAGE=node:22-bookworm-slim
# PGVECTOR_IMAGE=pgvector/pgvector:pg17

# Allowed model-service hostnames; comma-separated, without schemes or paths.
MODEL_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,openrouter.ai,localhost,127.0.0.1

# No administrator password or model API key belongs in this file.
# Set the administrator password in the first-run web page; model keys are temporary.
